# Copy this file to .env and fill in AIRTABLE_TOKEN. Never commit .env.

# --- Postgres (docker-compose wires these together) ---
# User/password/db created by the postgres:16 container on first start.
POSTGRES_USER=emg
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=emg_console
# Connection string the backend uses. Host "db" is the compose service name.
# Must match the three POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://emg:change-me-locally@db:5432/emg_console

# --- Airtable mirror (read-only Personal Access Token, scope: data.records:read) ---
# Create at https://airtable.com/create/tokens — grant only data.records:read
# on the "EMG logs" base.
AIRTABLE_TOKEN=
# Stage 3 edit write-through: a SECOND PAT with scope data.records:write
# (+read), restricted to the "EMG logs" base. Kept separate from the
# read-only mirror token on purpose (least privilege).
AIRTABLE_WRITE_TOKEN=

# Base "EMG logs"
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Table "Customer Payments Log" (bound by table ID, not name)
AIRTABLE_PAYMENTS_TABLE=tblXXXXXXXXXXXXXX

# --- Google Sign-In (Stage 2) ---
# OAuth client ID of type "Web application" from Google Cloud Console →
# APIs & Services → Credentials. Authorized JavaScript origins must include
# https://localhost:5173 and the nip.io LAN origins used for phone testing
# (e.g. https://192.168.1.50.nip.io:5173 — Google rejects bare-IP origins).
GOOGLE_CLIENT_ID=

# Signs the emg_session cookie. Generate once: a random alphanumeric string,
# 40+ characters, never reused anywhere else. Changing it logs everyone out.
SESSION_SECRET=

# --- Web Push (push mechanics slice) ---
# VAPID keypair for browser push notifications. Generate a pair with:
#   docker compose exec backend python -m app.scripts.generate_vapid_keys
# then paste all three lines here (local) / into the Azure Web App settings
# (prod). Optional: leave blank to run the console with push disabled. Dev and
# prod may hold different pairs for this mechanics test. PUBLIC key is exposed
# to the browser (safe); keep PRIVATE key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- Decision flow pilot (n8n ⇄ console) ---
# Shared secret authenticating BOTH directions: inbound hooks require it in the
# X-Pilot-Secret header; the outbound trigger and decision resume include it in
# their payloads. REQUIRED (app fails fast without it). Generate once: random
# alphanumeric, 40 characters, never reused anywhere else.
PILOT_HOOK_SECRET=
# The cloned CHECK-BOT's inbound webhook. Leave empty until it exists —
# empty disables the outbound check-submitted trigger (dev keeps working).
N8N_PILOT_WEBHOOK_URL=
# Who receives question/resolution pushes (comma list, intersected with
# roles admin/manager). Currently the two pilot accounts.
PILOT_PUSH_EMAILS=owner@example.com,owner-phone@example.com

# --- App ---
ENVIRONMENT=local
